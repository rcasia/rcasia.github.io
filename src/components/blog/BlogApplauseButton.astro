---
interface Props {
  variant: 'inline' | 'rail' | 'footer' | 'dock';
}

const { variant } = Astro.props;
---

<button
  type="button"
  class="applause-btn"
  data-applause-button
  data-variant={variant}
  aria-label="Applaud this post"
>
  <svg
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
    data-applause-icon
  >
    <path d="M12 2.5v3" />
    <path d="M6.6 4.2l1.5 2.6" />
    <path d="M17.4 4.2l-1.5 2.6" />
    <rect x="3.2" y="9.5" width="6.4" height="9" rx="3.2" transform="rotate(-14 6.4 14)" />
    <rect x="14.4" y="9.5" width="6.4" height="9" rx="3.2" transform="rotate(14 17.6 14)" />
  </svg>
  {variant === 'footer' && <span class="applause-btn-text">Applaud</span>}
</button>
