---
import type { Project } from '../../lib/projects';

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="card-grid">
  {
    projects.map(({ repo, tech }, i) => {
      const featured = i === 0;
      return (
        <a
          class:list={['card', 'project-card', { 'project-card-featured': featured }]}
          href={repo.html_url}
          target="_blank"
          rel="noopener"
        >
          <h3 title={repo.name}>
            {repo.name}
          </h3>
          <img
            src={`https://img.shields.io/github/stars/${repo.full_name}`}
            alt={`GitHub stars for ${repo.name}`}
            loading="lazy"
            class="project-stars"
          />
          {repo.description && <p>{repo.description}</p>}
          <div class="card-meta project-meta">
            <span aria-label={`GitHub repository for ${repo.name}`}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.35 1.08 2.92.83.1-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
              </svg>
            </span>
            {tech.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </a>
      );
    })
  }
</div>
{projects.length === 0 && <p style="color: var(--muted);">No projects to show right now.</p>}
