---
import '../styles/global.css';
import { SITE } from '../site';
import { DEPLOYMENT } from '../lib/deployment';
import { DEFAULT_PROJECTS_LAYOUT, DEFAULT_SITE_STYLE, PROJECTS_LAYOUTS, SITE_STYLES } from '../lib/visual-variants';

interface Props {
  title?: string;
  description?: string;
  current?: 'about' | 'blog' | 'projects' | 'contact';
}

const { title = SITE.title, description = SITE.description, current } = Astro.props;
const pageTitle = title === SITE.title ? title : `${title} | ${SITE.name}`;
const canonical = new URL(Astro.url.pathname, SITE.url).toString();
const siteStyleValues = SITE_STYLES.map(({ value }) => value);
const projectsLayoutValues = PROJECTS_LAYOUTS.map(({ value }) => value);
---

<!doctype html>
<html
  lang="en"
  data-theme="dark"
  data-site-style={DEFAULT_SITE_STYLE}
  data-projects-layout={DEFAULT_PROJECTS_LAYOUT}
  class:list={current === 'projects' ? 'projects-layout-page' : undefined}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="deployment-version" content={DEPLOYMENT.version} />
    <meta name="deployment-commit" content={DEPLOYMENT.commit ?? ''} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE.url}/og-image.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.url}/og-image.jpg`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('/rss.xml', SITE.url).toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />

    <script define:vars={{ deployment: DEPLOYMENT }}>
      window.__SITE_DEPLOYMENT__ = deployment;
    </script>

    <script is:inline define:vars={{ siteStyleValues, projectsLayoutValues, defaultSiteStyle: DEFAULT_SITE_STYLE, defaultProjectsLayout: DEFAULT_PROJECTS_LAYOUT }}>
      try {
        const root = document.documentElement;
        try {
          const deployedVersion = window.__SITE_DEPLOYMENT__ && window.__SITE_DEPLOYMENT__.version;
          if (deployedVersion && sessionStorage.getItem('siteDeploymentVersion') !== deployedVersion) {
            sessionStorage.removeItem('siteStyle');
            sessionStorage.removeItem('projectsLayout');
            sessionStorage.removeItem('projectsV2');
            sessionStorage.removeItem('bioRefresh');
            sessionStorage.removeItem('blogApplause');
            sessionStorage.removeItem('readingProgress');
            sessionStorage.removeItem('homeCta');
            sessionStorage.removeItem('blogShare');
            sessionStorage.setItem('siteDeploymentVersion', deployedVersion);
          }
        } catch {}
        try {
          localStorage.removeItem('siteStyle');
          localStorage.removeItem('projectsLayout');
          localStorage.removeItem('projectsV2');
          localStorage.removeItem('bioRefresh');
          localStorage.removeItem('blogApplause');
          localStorage.removeItem('readingProgress');
          localStorage.removeItem('homeCta');
          localStorage.removeItem('blogShare');
        } catch {}
        const storedStyle = sessionStorage.getItem('siteStyle');
        const siteStyle = siteStyleValues.includes(storedStyle) ? storedStyle : defaultSiteStyle;
        const storedLayout = sessionStorage.getItem('projectsLayout');
        const legacyLayout = sessionStorage.getItem('projectsV2') === 'true' ? 'expanded' : defaultProjectsLayout;
        const projectsLayout = projectsLayoutValues.includes(storedLayout) ? storedLayout : legacyLayout;
        root.setAttribute('data-site-style', siteStyle);
        root.setAttribute('data-projects-layout', projectsLayout);
        // Home bio refresh experiment. Disabled by default, no visible UI for visitors.
        const bioRefresh = sessionStorage.getItem('bioRefresh');
        root.setAttribute('data-bio-refresh', bioRefresh === 'on' ? 'on' : 'off');
        // Blog applause experiment. Disabled by default, no visible UI for visitors.
        const blogApplause = sessionStorage.getItem('blogApplause');
        root.setAttribute('data-blog-applause', blogApplause === 'on' ? 'on' : 'off');
        // Blog reading progress experiment. Disabled by default, no visible UI for visitors.
        // Modes: off, top, percent, vbar, ring. Unknown values fall back to off.
        const readingProgressOptions = ['top', 'percent', 'vbar', 'ring'];
        const storedReadingProgress = sessionStorage.getItem('readingProgress');
        const readingProgress = readingProgressOptions.includes(storedReadingProgress) ? storedReadingProgress : 'off';
        root.setAttribute('data-reading-progress', readingProgress);
        // Home CTA experiment. Disabled by default, no visible UI for visitors.
        const homeCta = sessionStorage.getItem('homeCta');
        root.setAttribute('data-home-cta', homeCta === 'on' ? 'on' : 'off');
        // Blog share experiment. Disabled by default, no visible UI for visitors.
        const blogShare = sessionStorage.getItem('blogShare');
        root.setAttribute('data-blog-share', blogShare === 'on' ? 'on' : 'off');
      } catch {}
    </script>

    {
      SITE.gaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaId}`} />
          <script
            is:inline
            define:vars={{ gaId: SITE.gaId }}
            dangerouslySetInnerHTML={{
              __html: `window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',gaId);`,
            }}
          />
        </>
      )
    }
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') {
          document.documentElement.setAttribute('data-theme', saved);
        }
        const syncThemeToggle = () => {
          const btn = document.getElementById('theme-toggle');
          if (!btn) return;
          const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
          btn.setAttribute('aria-pressed', String(isDark));
          btn.textContent = isDark ? '☾' : '☀';
          btn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncThemeToggle);
        } else {
          syncThemeToggle();
        }
      } catch {}
    </script>
    <style>
      #feature-flag-panel {
        width: min(440px, calc(100% - 2rem));
        padding: 0;
        border: 1px solid var(--border);
        border-radius: 12px;
        background: var(--bg-soft);
        color: var(--text);
      }

      #feature-flag-panel::backdrop {
        background: rgb(0 0 0 / 65%);
      }

      .feature-flag-panel {
        display: grid;
        gap: 0.7rem;
        padding: 1rem;
        max-height: min(86vh, 720px);
        overflow: hidden;
      }

      .feature-flag-panel h2,
      .feature-flag-panel p {
        margin: 0;
      }

      .feature-flag-panel p {
        color: var(--muted);
        font-size: 0.9rem;
      }

      .feature-flag-head {
        display: grid;
        gap: 0.35rem;
      }

      .feature-flag-summary {
        font-size: 0.85rem;
      }

      .feature-flag-summary[data-state='modified'] {
        color: var(--accent);
      }

      .feature-flag-panel label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
      }

      .feature-flag-accordion {
        display: grid;
        gap: 0.4rem;
      }

      .feature-flag-item {
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
      }

      .feature-flag-trigger {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.6rem;
        padding: 0.5rem 0.65rem;
        font-weight: 600;
      }

      .feature-flag-trigger-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;
      }

      .feature-flag-trigger-name {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .feature-flag-trigger-side {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        flex: none;
      }

      .feature-flag-chevron {
        color: var(--muted);
        font-size: 0.85rem;
      }

      .feature-flag-trigger[aria-expanded='true'] .feature-flag-chevron {
        color: var(--accent);
      }

      .feature-flag-detail {
        display: grid;
        gap: 0.4rem;
        padding: 0 0.65rem 0.65rem;
      }

      .feature-flag-detail[hidden] {
        display: none;
      }

      .feature-flag-field {
        display: grid;
        gap: 0.4rem;
      }

      .feature-flag-field label {
        font-weight: 600;
      }

      .feature-flag-badge {
        flex: none;
        border: 1px solid var(--border);
        border-radius: 999px;
        padding: 0.1rem 0.55rem;
        font-size: 0.75rem;
        color: var(--muted);
      }

      .feature-flag-badge[data-state='modified'] {
        border-color: var(--accent);
        color: var(--accent);
      }

      .feature-flag-field select {
        width: 100%;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.5rem 0.65rem;
        background: var(--bg);
        color: var(--text);
      }

      .feature-flag-field p {
        margin: 0;
      }

      .feature-flag-panel select {
        min-width: 9rem;
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.35rem 0.5rem;
        background: var(--bg);
        color: var(--text);
        font: inherit;
      }

      .feature-flag-mini {
        justify-self: start;
        font-size: 0.8rem;
      }

      .feature-flag-panel-actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 0.6rem;
      }

      .feature-flag-panel button {
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 0.45rem 0.7rem;
        background: transparent;
        color: var(--text);
        cursor: pointer;
      }

      .feature-flag-panel button:hover,
      .feature-flag-panel button:focus-visible {
        border-color: var(--accent);
        color: var(--accent);
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="ambient" aria-hidden="true">
      <span class="ambient-aurora-a"></span>
      <span class="ambient-aurora-b"></span>
    </div>
    <header class="navbar">
      <div class="navbar-inner">
        <div class="brand-group">
          <a class="brand" href="/">Ricardo Casía Moka</a>
          <div class="social-row" aria-label="Social links">
            <a href="/contact/" aria-label="Contact information">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M2 5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5Zm2.3.5 7.7 6 7.7-6H4.3Z"/></svg>
            </a>
            <a href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub profile">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.35 1.08 2.92.83.1-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
            </a>
            <a href={SITE.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn profile">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5A2.49 2.49 0 1 1 0 3.5a2.49 2.49 0 0 1 4.98 0ZM.2 8.4h4.6V24H.2V8.4Zm7.6 0h4.4v2.1h.1c.6-1.2 2.1-2.4 4.4-2.4 4.7 0 5.6 3.1 5.6 7.1V24h-4.6v-7.7c0-1.8 0-4.2-2.6-4.2s-3 2-3 4V24H7.8V8.4Z"/></svg>
            </a>
            <a href={SITE.x} target="_blank" rel="noopener" aria-label="X profile">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.3l7.3-8.3L1.6 2H8l4.4 5.9L18.9 2Zm-1.1 18h1.7L7 3.9H5.2L17.8 20Z"/></svg>
            </a>
          </div>
        </div>
        <nav aria-label="Primary">
          <ul class="nav-links">
            <li><a href="/" aria-current={current === 'about' ? 'page' : undefined}>home</a></li>
            <li><a href="/blog/" aria-current={current === 'blog' ? 'page' : undefined}>blog</a></li>
            <li><a href="/projects/" aria-current={current === 'projects' ? 'page' : undefined}>projects</a></li>
            <li><a href="/contact/" aria-current={current === 'contact' ? 'page' : undefined}>contact</a></li>
            <li><button class="theme-toggle" id="theme-toggle" aria-label="Switch to light theme" aria-pressed="true">☾</button></li>
          </ul>
        </nav>
      </div>
    </header>

    <dialog id="feature-flag-panel" aria-labelledby="feature-flag-panel-title" aria-describedby="feature-flag-panel-description">
      <form class="feature-flag-panel" method="dialog">
        <div class="feature-flag-head">
          <h2 id="feature-flag-panel-title">Feature flags</h2>
          <p id="feature-flag-status" class="feature-flag-summary" role="status" aria-live="polite">All defaults</p>
        </div>
        <p id="feature-flag-panel-description">
          Developer-only controls for this tab. Select a feature to tweak it. Changes preview instantly. Shortcut: Ctrl+Alt+Shift+F (macOS: Control+Command+Shift+F).
        </p>
        <div class="feature-flag-accordion">
          <div class="feature-flag-item">
            <button type="button" class="feature-flag-trigger" id="feature-flag-trigger-siteStyle" data-accordion-for="siteStyle" aria-expanded="true" aria-controls="feature-flag-detail-siteStyle">
              <span class="feature-flag-trigger-meta">
                <span class="feature-flag-trigger-name">Global site style</span>
              </span>
              <span class="feature-flag-trigger-side">
                <span class="feature-flag-badge" data-badge-for="siteStyle" data-state="default">Default</span>
                <span class="feature-flag-chevron" aria-hidden="true">▾</span>
              </span>
            </button>
            <div class="feature-flag-detail" id="feature-flag-detail-siteStyle" data-accordion-panel="siteStyle" role="region" aria-labelledby="feature-flag-trigger-siteStyle">
              <div class="feature-flag-field">
                <label for="feature-flag-siteStyle">Global site style</label>
                <select id="feature-flag-siteStyle" data-feature-flag="siteStyle" aria-describedby="feature-flag-siteStyle-description">
                  {SITE_STYLES.map((style) => <option value={style.value}>{style.label}</option>)}
                </select>
                <p id="feature-flag-siteStyle-description">Global appearance. Shared visual language. Default: Technical.</p>
                <button type="button" class="feature-flag-mini" data-reset-flag="siteStyle">Reset to default</button>
              </div>
            </div>
          </div>
          <div class="feature-flag-item">
            <button type="button" class="feature-flag-trigger" id="feature-flag-trigger-projectsLayout" data-accordion-for="projectsLayout" aria-expanded="false" aria-controls="feature-flag-detail-projectsLayout">
              <span class="feature-flag-trigger-meta">
                <span class="feature-flag-trigger-name">Projects layout</span>
              </span>
              <span class="feature-flag-trigger-side">
                <span class="feature-flag-badge" data-badge-for="projectsLayout" data-state="default">Default</span>
                <span class="feature-flag-chevron" aria-hidden="true">▾</span>
              </span>
            </button>
            <div class="feature-flag-detail" id="feature-flag-detail-projectsLayout" data-accordion-panel="projectsLayout" role="region" aria-labelledby="feature-flag-trigger-projectsLayout" hidden>
              <div class="feature-flag-field">
                <label for="feature-flag-projectsLayout">Projects layout</label>
                <select id="feature-flag-projectsLayout" data-feature-flag="projectsLayout" aria-describedby="feature-flag-projectsLayout-description">
                  {PROJECTS_LAYOUTS.map((layout) => <option value={layout.value}>{layout.label}</option>)}
                </select>
                <p id="feature-flag-projectsLayout-description">Global appearance. Projects-only composition. Default: Showcase.</p>
                <button type="button" class="feature-flag-mini" data-reset-flag="projectsLayout">Reset to default</button>
              </div>
            </div>
          </div>
          <div class="feature-flag-item">
            <button type="button" class="feature-flag-trigger" id="feature-flag-trigger-bioRefresh" data-accordion-for="bioRefresh" aria-expanded="false" aria-controls="feature-flag-detail-bioRefresh">
              <span class="feature-flag-trigger-meta">
                <span class="feature-flag-trigger-name">Home bio refresh</span>
              </span>
              <span class="feature-flag-trigger-side">
                <span class="feature-flag-badge" data-badge-for="bioRefresh" data-state="default">Default</span>
                <span class="feature-flag-chevron" aria-hidden="true">▾</span>
              </span>
            </button>
            <div class="feature-flag-detail" id="feature-flag-detail-bioRefresh" data-accordion-panel="bioRefresh" role="region" aria-labelledby="feature-flag-trigger-bioRefresh" hidden>
              <div class="feature-flag-field">
                <label for="feature-flag-bioRefresh">Home bio refresh</label>
                <select id="feature-flag-bioRefresh" data-feature-flag="bioRefresh" aria-describedby="feature-flag-bioRefresh-description">
                  <option value="off">Off</option>
                  <option value="on">On</option>
                </select>
                <p id="feature-flag-bioRefresh-description">Home content. LinkedIn-informed hero bio. Default: Off.</p>
                <button type="button" class="feature-flag-mini" data-reset-flag="bioRefresh">Reset to default</button>
              </div>
            </div>
          </div>
          <div class="feature-flag-item">
            <button type="button" class="feature-flag-trigger" id="feature-flag-trigger-blogApplause" data-accordion-for="blogApplause" aria-expanded="false" aria-controls="feature-flag-detail-blogApplause">
              <span class="feature-flag-trigger-meta">
                <span class="feature-flag-trigger-name">Blog applause</span>
              </span>
              <span class="feature-flag-trigger-side">
                <span class="feature-flag-badge" data-badge-for="blogApplause" data-state="default">Default</span>
                <span class="feature-flag-chevron" aria-hidden="true">▾</span>
              </span>
            </button>
            <div class="feature-flag-detail" id="feature-flag-detail-blogApplause" data-accordion-panel="blogApplause" role="region" aria-labelledby="feature-flag-trigger-blogApplause" hidden>
              <div class="feature-flag-field">
                <label for="feature-flag-blogApplause">Blog applause</label>
                <select id="feature-flag-blogApplause" data-feature-flag="blogApplause" aria-describedby="feature-flag-blogApplause-description">
                  <option value="off">Off</option>
                  <option value="on">On</option>
                </select>
                <p id="feature-flag-blogApplause-description">Blog. Local applause controls on posts. Default: Off.</p>
                <button type="button" class="feature-flag-mini" data-reset-flag="blogApplause">Reset to default</button>
              </div>
            </div>
          </div>
          <div class="feature-flag-item">
            <button type="button" class="feature-flag-trigger" id="feature-flag-trigger-readingProgress" data-accordion-for="readingProgress" aria-expanded="false" aria-controls="feature-flag-detail-readingProgress">
              <span class="feature-flag-trigger-meta">
                <span class="feature-flag-trigger-name">Blog reading progress</span>
              </span>
              <span class="feature-flag-trigger-side">
                <span class="feature-flag-badge" data-badge-for="readingProgress" data-state="default">Default</span>
                <span class="feature-flag-chevron" aria-hidden="true">▾</span>
              </span>
            </button>
            <div class="feature-flag-detail" id="feature-flag-detail-readingProgress" data-accordion-panel="readingProgress" role="region" aria-labelledby="feature-flag-trigger-readingProgress" hidden>
              <div class="feature-flag-field">
                <label for="feature-flag-readingProgress">Blog reading progress</label>
                <select id="feature-flag-readingProgress" data-feature-flag="readingProgress" aria-describedby="feature-flag-readingProgress-description">
                  <option value="off">Off</option>
                  <option value="top">Top bar</option>
                  <option value="percent">Percent in left rail</option>
                  <option value="vbar">Vertical bar in left rail</option>
                  <option value="ring">Ring around applause button</option>
                </select>
                <p id="feature-flag-readingProgress-description">Blog. Top bar, or a readout beside the left applause icon. Rail readouts need Blog applause set to On and a wide screen. Default: Off.</p>
                <button type="button" class="feature-flag-mini" data-reset-flag="readingProgress">Reset to default</button>
              </div>
            </div>
          </div>
          <div class="feature-flag-item">
            <button type="button" class="feature-flag-trigger" id="feature-flag-trigger-homeCta" data-accordion-for="homeCta" aria-expanded="false" aria-controls="feature-flag-detail-homeCta">
              <span class="feature-flag-trigger-meta">
                <span class="feature-flag-trigger-name">Home CTAs</span>
              </span>
              <span class="feature-flag-trigger-side">
                <span class="feature-flag-badge" data-badge-for="homeCta" data-state="default">Default</span>
                <span class="feature-flag-chevron" aria-hidden="true">▾</span>
              </span>
            </button>
            <div class="feature-flag-detail" id="feature-flag-detail-homeCta" data-accordion-panel="homeCta" role="region" aria-labelledby="feature-flag-trigger-homeCta" hidden>
              <div class="feature-flag-field">
                <label for="feature-flag-homeCta">Home CTAs</label>
                <select id="feature-flag-homeCta" data-feature-flag="homeCta" aria-describedby="feature-flag-homeCta-description">
                  <option value="off">Off</option>
                  <option value="on">On</option>
                </select>
                <p id="feature-flag-homeCta-description">Home. Clearer hierarchy for View selected work, Get in touch, and GitHub. Default: Off.</p>
                <button type="button" class="feature-flag-mini" data-reset-flag="homeCta">Reset to default</button>
              </div>
            </div>
          </div>
          <div class="feature-flag-item">
            <button type="button" class="feature-flag-trigger" id="feature-flag-trigger-blogShare" data-accordion-for="blogShare" aria-expanded="false" aria-controls="feature-flag-detail-blogShare">
              <span class="feature-flag-trigger-meta">
                <span class="feature-flag-trigger-name">Blog share</span>
              </span>
              <span class="feature-flag-trigger-side">
                <span class="feature-flag-badge" data-badge-for="blogShare" data-state="default">Default</span>
                <span class="feature-flag-chevron" aria-hidden="true">▾</span>
              </span>
            </button>
            <div class="feature-flag-detail" id="feature-flag-detail-blogShare" data-accordion-panel="blogShare" role="region" aria-labelledby="feature-flag-trigger-blogShare" hidden>
              <div class="feature-flag-field">
                <label for="feature-flag-blogShare">Blog share</label>
                <select id="feature-flag-blogShare" data-feature-flag="blogShare" aria-describedby="feature-flag-blogShare-description">
                  <option value="off">Off</option>
                  <option value="on">On</option>
                </select>
                <p id="feature-flag-blogShare-description">Blog. Share links on posts. Default: Off.</p>
                <button type="button" class="feature-flag-mini" data-reset-flag="blogShare">Reset to default</button>
              </div>
            </div>
          </div>
        </div>
        <div class="feature-flag-panel-actions">
          <button id="feature-flag-reset" type="button">Reset to defaults</button>
          <button type="submit" value="cancel">Close</button>
          <button id="feature-flag-apply" type="button">Apply and reload</button>
        </div>
      </form>
    </dialog>

    <main id="main" class="container">
      <slot />
    </main>

    <footer>
      <nav aria-label="Footer">
        <a href="/">Home</a>
        <a href="/blog/">Blog</a>
        <a href="/projects/">Projects</a>
        <a href={SITE.github} target="_blank" rel="noopener">GitHub</a>
      </nav>
      <div>© {new Date().getFullYear()} Ricardo Casía Moka.</div>
      <div class="build-meta">build {DEPLOYMENT.version.replace('-', ' · ')}</div>
    </footer>

    <script is:inline>
      const themeToggle = document.getElementById('theme-toggle');
      const syncThemeToggle = (theme) => {
        if (!themeToggle) return;
        const isDark = theme !== 'light';
        themeToggle.setAttribute('aria-pressed', String(isDark));
        themeToggle.textContent = isDark ? '☾' : '☀';
        themeToggle.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
      };
      syncThemeToggle(document.documentElement.getAttribute('data-theme'));
      themeToggle?.addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        syncThemeToggle(next);
        try {
          localStorage.setItem('theme', next);
        } catch {}
      });
    </script>

    <script is:inline define:vars={{ defaultSiteStyle: DEFAULT_SITE_STYLE, defaultProjectsLayout: DEFAULT_PROJECTS_LAYOUT }}>
      const featureFlagPanel = document.getElementById('feature-flag-panel');
      const featureFlagInputs = Array.from(document.querySelectorAll('select[data-feature-flag]'));
      const featureFlagApply = document.getElementById('feature-flag-apply');
      const featureFlagReset = document.getElementById('feature-flag-reset');
      const featureFlagStatus = document.getElementById('feature-flag-status');
      const featureFlagBadges = Array.from(document.querySelectorAll('[data-badge-for]'));
      const featureFlagSingleResets = Array.from(document.querySelectorAll('[data-reset-flag]'));
      const featureFlagTriggers = Array.from(document.querySelectorAll('[data-accordion-for]'));
      const featureFlagDetails = Array.from(document.querySelectorAll('[data-accordion-panel]'));
      let featureFlagPanelReturnFocus = null;

      const setOpenFlag = (key) => {
        featureFlagTriggers.forEach((trigger) => {
          const isOpen = trigger.getAttribute('data-accordion-for') === key;
          trigger.setAttribute('aria-expanded', String(isOpen));
        });
        featureFlagDetails.forEach((detail) => {
          const isOpen = detail.getAttribute('data-accordion-panel') === key;
          if (isOpen) detail.removeAttribute('hidden');
          else detail.setAttribute('hidden', '');
        });
      };

      const getFirstModifiedFlag = () => {
        const modified = featureFlagInputs.find((input) => {
          const key = input.dataset.featureFlag;
          return key && input.value !== getFlagDefault(key);
        });
        return modified?.dataset.featureFlag || featureFlagTriggers[0]?.getAttribute('data-accordion-for') || 'siteStyle';
      };

      const readFeatureFlag = (key) => {
        try {
          return sessionStorage.getItem(key);
        } catch {
          return null;
        }
      };

      const isFeatureFlagEnabled = (key) => readFeatureFlag(key) === 'true';

      const getFlagDefault = (key) => {
        if (key === 'siteStyle') return defaultSiteStyle;
        if (key === 'projectsLayout') return defaultProjectsLayout;
        if (key === 'bioRefresh' || key === 'blogApplause' || key === 'readingProgress' || key === 'homeCta' || key === 'blogShare') return 'off';
        return '';
      };

      const getFlagAttribute = (key) => {
        if (key === 'siteStyle') return 'data-site-style';
        if (key === 'projectsLayout') return 'data-projects-layout';
        if (key === 'bioRefresh') return 'data-bio-refresh';
        if (key === 'blogApplause') return 'data-blog-applause';
        if (key === 'readingProgress') return 'data-reading-progress';
        if (key === 'homeCta') return 'data-home-cta';
        if (key === 'blogShare') return 'data-blog-share';
        return null;
      };

      const syncBioHero = (value) => {
        const isOn = value === 'on';
        document.querySelectorAll('[data-hero-stable]').forEach((el) => {
          if (isOn) el.setAttribute('hidden', '');
          else el.removeAttribute('hidden');
        });
        document.querySelectorAll('[data-hero-experiment]').forEach((el) => {
          if (isOn) el.removeAttribute('hidden');
          else el.setAttribute('hidden', '');
        });
      };

      const syncHomeCta = (value) => {
        const isOn = value === 'on';
        document.querySelectorAll('[data-cta-stable]').forEach((el) => {
          if (isOn) el.setAttribute('hidden', '');
          else el.removeAttribute('hidden');
        });
        document.querySelectorAll('[data-cta-experiment]').forEach((el) => {
          if (isOn) el.removeAttribute('hidden');
          else el.setAttribute('hidden', '');
        });
      };

      const applyFlagLive = (key, value) => {
        try {
          sessionStorage.setItem(key, value);
        } catch {}
        try {
          localStorage.removeItem(key);
          if (key === 'projectsLayout') localStorage.removeItem('projectsV2');
        } catch {}
        const attribute = getFlagAttribute(key);
        if (attribute) document.documentElement.setAttribute(attribute, value);
        if (key === 'bioRefresh') syncBioHero(value);
        if (key === 'homeCta') syncHomeCta(value);
        if (key === 'readingProgress' || key === 'blogApplause' || key === 'blogShare') {
          try {
            window.dispatchEvent(new Event('resize'));
            window.dispatchEvent(new Event('scroll'));
          } catch {}
        }
      };

      const updateFlagBadges = () => {
        let modified = 0;
        featureFlagInputs.forEach((input) => {
          const key = input.dataset.featureFlag;
          if (!key) return;
          const isModified = input.value !== getFlagDefault(key);
          if (isModified) modified += 1;
          const badge = featureFlagBadges.find((item) => item.getAttribute('data-badge-for') === key);
          if (badge) {
            badge.textContent = isModified ? 'Modified' : 'Default';
            badge.setAttribute('data-state', isModified ? 'modified' : 'default');
          }
        });
        if (featureFlagStatus) {
          const total = featureFlagInputs.length;
          featureFlagStatus.textContent = modified === 0 ? 'All defaults' : `${modified} of ${total} modified, previewing live`;
          featureFlagStatus.setAttribute('data-state', modified === 0 ? 'default' : 'modified');
        }
      };

      const syncFeatureFlagInputs = () => {
        featureFlagInputs.forEach((input) => {
          const key = input.dataset.featureFlag;
          if (!key) return;
          const fallback = getFlagDefault(key);
          const storedValue = readFeatureFlag(key);
          const stored = key === 'projectsLayout' && !storedValue
            ? (isFeatureFlagEnabled('projectsV2') ? 'expanded' : defaultProjectsLayout)
            : storedValue;
          const optionValues = Array.from(input.options).map((option) => option.value);
          input.value = stored && optionValues.includes(stored) ? stored : fallback;
        });
        updateFlagBadges();
      };

      const openFeatureFlagPanel = () => {
        if (!(featureFlagPanel instanceof HTMLDialogElement) || featureFlagPanel.open) return;
        featureFlagPanelReturnFocus = document.activeElement;
        syncFeatureFlagInputs();
        const initial = getFirstModifiedFlag();
        setOpenFlag(initial);
        featureFlagPanel.showModal();
        featureFlagTriggers.find((trigger) => trigger.getAttribute('data-accordion-for') === initial)?.focus();
      };

      document.addEventListener('keydown', (event) => {
        const isMacShortcut = event.metaKey && event.ctrlKey && event.shiftKey && !event.altKey;
        const isOtherPlatformShortcut = event.ctrlKey && event.altKey && event.shiftKey && !event.metaKey;
        if (event.code === 'KeyF' && (isMacShortcut || isOtherPlatformShortcut)) {
          event.preventDefault();
          openFeatureFlagPanel();
        }
      });

      featureFlagPanel?.addEventListener('close', () => {
        if (featureFlagPanelReturnFocus instanceof HTMLElement) featureFlagPanelReturnFocus.focus();
        featureFlagPanelReturnFocus = null;
      });

      featureFlagTriggers.forEach((trigger, index) => {
        trigger.addEventListener('click', () => {
          const key = trigger.getAttribute('data-accordion-for');
          if (key) setOpenFlag(key);
        });
        trigger.addEventListener('keydown', (event) => {
          if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp' && event.key !== 'Home' && event.key !== 'End') return;
          event.preventDefault();
          let next = index;
          if (event.key === 'ArrowDown') next = (index + 1) % featureFlagTriggers.length;
          if (event.key === 'ArrowUp') next = (index - 1 + featureFlagTriggers.length) % featureFlagTriggers.length;
          if (event.key === 'Home') next = 0;
          if (event.key === 'End') next = featureFlagTriggers.length - 1;
          featureFlagTriggers[next]?.focus();
        });
      });

      featureFlagInputs.forEach((input) => {
        input.addEventListener('change', () => {
          const key = input.dataset.featureFlag;
          if (!key) return;
          applyFlagLive(key, input.value);
          updateFlagBadges();
        });
      });

      featureFlagSingleResets.forEach((button) => {
        button.addEventListener('click', (event) => {
          event.preventDefault();
          const key = button.getAttribute('data-reset-flag');
          if (!key) return;
          const input = featureFlagInputs.find((item) => item.dataset.featureFlag === key);
          const fallback = getFlagDefault(key);
          if (input) input.value = fallback;
          applyFlagLive(key, fallback);
          updateFlagBadges();
          const target = featureFlagInputs.find((item) => item.dataset.featureFlag === key);
          target?.focus();
        });
      });

      featureFlagApply?.addEventListener('click', () => {
        try {
          featureFlagInputs.forEach((input) => {
            const key = input.dataset.featureFlag;
            if (!key) return;
            sessionStorage.setItem(key, input.value);
          });
          sessionStorage.removeItem('projectsV2');
          try {
            localStorage.removeItem('siteStyle');
            localStorage.removeItem('projectsLayout');
            localStorage.removeItem('projectsV2');
            localStorage.removeItem('bioRefresh');
            localStorage.removeItem('blogApplause');
            localStorage.removeItem('readingProgress');
            localStorage.removeItem('homeCta');
            localStorage.removeItem('blogShare');
          } catch {}
          featureFlagPanel.close();
          location.reload();
        } catch {}
      });

      featureFlagReset?.addEventListener('click', () => {
        try {
          sessionStorage.removeItem('siteStyle');
          sessionStorage.removeItem('projectsLayout');
          sessionStorage.removeItem('projectsV2');
          sessionStorage.removeItem('bioRefresh');
          sessionStorage.removeItem('blogApplause');
          sessionStorage.removeItem('readingProgress');
          sessionStorage.removeItem('homeCta');
          sessionStorage.removeItem('blogShare');
          try {
            localStorage.removeItem('siteStyle');
            localStorage.removeItem('projectsLayout');
            localStorage.removeItem('projectsV2');
            localStorage.removeItem('bioRefresh');
            localStorage.removeItem('blogApplause');
            localStorage.removeItem('readingProgress');
            localStorage.removeItem('homeCta');
            localStorage.removeItem('blogShare');
          } catch {}
          featureFlagPanel.close();
          location.reload();
        } catch {}
      });
    </script>
    <script is:inline>
      try {
        if (sessionStorage.getItem('bioRefresh') === 'on') {
          document.documentElement.setAttribute('data-bio-refresh', 'on');
          document.querySelectorAll('[data-hero-stable]').forEach((el) => {
            el.setAttribute('hidden', '');
          });
          document.querySelectorAll('[data-hero-experiment][hidden]').forEach((el) => {
            el.removeAttribute('hidden');
          });
        }
        if (sessionStorage.getItem('blogApplause') === 'on') {
          document.documentElement.setAttribute('data-blog-applause', 'on');
        }
        if (sessionStorage.getItem('homeCta') === 'on') {
          document.documentElement.setAttribute('data-home-cta', 'on');
          document.querySelectorAll('[data-cta-stable]').forEach((el) => {
            el.setAttribute('hidden', '');
          });
          document.querySelectorAll('[data-cta-experiment][hidden]').forEach((el) => {
            el.removeAttribute('hidden');
          });
        }
        if (sessionStorage.getItem('blogShare') === 'on') {
          document.documentElement.setAttribute('data-blog-share', 'on');
        }
      } catch {}
    </script>
  </body>
</html>
