---
import Base from '../../layouts/Base.astro';
import BlogApplauseButton from '../../components/blog/BlogApplauseButton.astro';
import BlogShare from '../../components/blog/BlogShare.astro';
import { getCollection, render } from 'astro:content';
import { SITE } from '../../site';
import { formatDate, getReadTime } from '../../dates';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Only build local posts; redirect-only posts link out from the index.
  return posts
    .filter((post) => !post.data.redirect)
    .map((post) => ({
      params: { slug: post.id.replace(/\.md$/, '') },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const readTime = getReadTime(post.body);
const publishedDate = post.data.date.toISOString().slice(0, 10);
const slug = post.id.replace(/\.md$/, '');
const shareUrl = new URL(`/blog/${slug}/`, SITE.url).toString();
const shareTitle = post.data.title;
const shareDescription = post.data.description;
---

<Base title={post.data.title} description={post.data.description} current="blog">
  <div
    class="reading-progress"
    data-reading-progress
    role="progressbar"
    aria-label="Reading progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    aria-valuetext="0% read"
  >
    <span class="reading-progress-bar" data-reading-progress-bar></span>
  </div>

  <div data-applause-root data-slug={slug}>
  <article class="blog-post">
    <header class="blog-post-header">
      <p class="blog-post-back"><a href="/blog/">← blog</a></p>
      <p class="blog-post-eyebrow">Reading note</p>
      <h1>{post.data.title}</h1>
      <p class="blog-post-description">{post.data.description}</p>
      <div class="blog-post-meta" aria-label="Post metadata">
        <time datetime={publishedDate}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readTime} min read</span>
      </div>
      <div class="applause-inline" data-blog-applause>
        <BlogApplauseButton variant="inline" />
        <p class="applause-count"><span data-applause-count>0</span> <span>applause</span></p>
      </div>
      <div class="share-inline" data-blog-share>
        <BlogShare variant="inline" url={shareUrl} title={shareTitle} description={shareDescription} />
      </div>
      {(post.data.tags.length > 0 || post.data.categories.length > 0) && (
        <ul class="blog-post-tags" aria-label="Post topics">
          {post.data.tags.map((tag) => <li><span class="tag">#{tag}</span></li>)}
          {post.data.categories.map((category) => <li><span class="tag">◎ {category}</span></li>)}
        </ul>
      )}
    </header>

    <div class="blog-post-grid">
      {tocHeadings.length > 0 && (
        <nav class="blog-toc" data-blog-toc aria-labelledby="blog-toc-title">
          <h2 id="blog-toc-title">On this page</h2>
          <ol>
            {tocHeadings.map((heading, index) => (
              <li class:list={{ 'blog-toc-subitem': heading.depth === 3 }}>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link={heading.slug}
                  aria-current={index === 0 ? 'location' : undefined}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose blog-post-content">
        <Content />
      </div>
    </div>
  </article>

  <aside class="applause-rail" data-blog-applause data-applause-rail role="group" aria-label="Applaud this post">
    <span class="rail-ring-wrap" data-rail-ring-wrap>
      <BlogApplauseButton variant="rail" />
      <svg class="rail-progress-ring" data-rail-progress-ring viewBox="0 0 62 62" aria-hidden="true" focusable="false">
        <circle cx="31" cy="31" r="27" fill="none" stroke="var(--border)" stroke-width="3" />
        <circle data-rail-progress-ring-fill cx="31" cy="31" r="27" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" transform="rotate(-90 31 31)" />
      </svg>
    </span>
    <p class="applause-count"><span data-applause-count>0</span></p>
    <p class="rail-progress-percent" data-rail-progress-percent aria-hidden="true">0%</p>
    <span class="rail-progress-vbar" data-rail-progress-vbar aria-hidden="true"><span data-rail-progress-vbar-fill></span></span>
  </aside>

  <section class="blog-applause" data-blog-applause data-applause-footer aria-labelledby="blog-applause-title">
    <h2 id="blog-applause-title">Enjoyed this note?</h2>
    <p class="muted">Applaud to save a local cheer. Tap again for more, or hold the button.</p>
    <div class="blog-applause-row">
      <BlogApplauseButton variant="footer" />
      <p class="applause-count"><span data-applause-count>0</span> <span>applause</span></p>
    </div>
    <p class="blog-applause-status muted" data-applause-status role="status"></p>
    <input type="text" name="company" value="" autocomplete="off" tabindex="-1" aria-hidden="true" data-applause-trap class="blog-applause-trap" />
  </section>

  <section class="blog-share-footer" data-blog-share data-share-footer aria-label="Share this post">
    <p class="share-footer-note muted">Pass it on</p>
    <BlogShare variant="footer" url={shareUrl} title={shareTitle} description={shareDescription} />
  </section>
  </div>

  <aside class="share-rail" data-blog-share data-share-rail role="group" aria-label="Share this post">
    <BlogShare variant="rail" url={shareUrl} title={shareTitle} description={shareDescription} />
  </aside>

  <div class="share-dock" data-blog-share data-share-dock role="group" aria-label="Share this post">
    <BlogShare variant="dock" url={shareUrl} title={shareTitle} description={shareDescription} />
  </div>

  <div class="applause-dock" data-blog-applause data-applause-dock role="group" aria-label="Applaud this post">
    <BlogApplauseButton variant="dock" />
    <p class="applause-count"><span data-applause-count>0</span></p>
  </div>

  <script is:inline>
    (() => {
      const blocks = Array.from(document.querySelectorAll('[data-share-block]'));
      if (blocks.length === 0) return;

      const canNativeShare = typeof navigator !== 'undefined' && typeof navigator.share === 'function';
      if (canNativeShare) {
        blocks.forEach((block) => {
          block.querySelectorAll('[data-share-native]').forEach((button) => {
            if (button instanceof HTMLButtonElement) button.removeAttribute('hidden');
          });
        });
      }

      const setExpanded = (block, open) => {
        const trigger = block.querySelector('[data-share-trigger]');
        const panel = block.querySelector('[data-share-panel]');
        if (!(trigger instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;
        trigger.setAttribute('aria-expanded', String(open));
        if (open) panel.removeAttribute('hidden');
        else panel.setAttribute('hidden', '');
      };

      blocks.forEach((block) => {
        const trigger = block.querySelector('[data-share-trigger]');
        if (trigger instanceof HTMLButtonElement) {
          trigger.addEventListener('click', () => {
            const isOpen = trigger.getAttribute('aria-expanded') === 'true';
            blocks.forEach((other) => {
              if (other !== block) setExpanded(other, false);
            });
            setExpanded(block, !isOpen);
          });
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        blocks.forEach((block) => setExpanded(block, false));
      });

      document.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest('[data-share-block]')) return;
        blocks.forEach((block) => setExpanded(block, false));
      });

      const setStatus = (block, message) => {
        const status = block.querySelector('[data-share-status]');
        if (status) status.textContent = message;
      };

      const copyText = async (text) => {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {}
        try {
          const area = document.createElement('textarea');
          area.value = text;
          area.setAttribute('readonly', '');
          area.style.position = 'fixed';
          area.style.opacity = '0';
          document.body.appendChild(area);
          area.select();
          const ok = document.execCommand('copy');
          area.remove();
          return ok;
        } catch {
          return false;
        }
      };

      blocks.forEach((block) => {
        const url = block.getAttribute('data-share-url') || window.location.href;
        const title = block.getAttribute('data-share-title') || document.title;
        const text = block.getAttribute('data-share-text') || '';

        block.querySelectorAll('[data-share-copy]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          button.addEventListener('click', async () => {
            const ok = await copyText(url);
            setStatus(block, ok ? 'Link copied.' : 'Copy failed. Long press the address bar to copy.');
          });
        });

        block.querySelectorAll('[data-share-native]').forEach((button) => {
          if (!(button instanceof HTMLButtonElement)) return;
          button.addEventListener('click', async () => {
            if (typeof navigator.share !== 'function') {
              setStatus(block, 'System share is not available. Use copy link instead.');
              return;
            }
            try {
              await navigator.share({ title, text, url });
            } catch (error) {
              if (error && error.name !== 'AbortError') {
                setStatus(block, 'Share failed. Use copy link instead.');
              }
            }
          });
        });
      });

      const rail = document.querySelector('[data-share-rail]');
      const dock = document.querySelector('[data-share-dock]');
      const footer = document.querySelector('[data-share-footer]');
      const header = document.querySelector('.blog-post-header');
      if (!rail && !dock) return;

      let pastHeader = false;
      let footerVisible = false;
      const updateVisibility = () => {
        const show = pastHeader && !footerVisible;
        if (rail instanceof HTMLElement) rail.classList.toggle('is-visible', show);
        if (dock instanceof HTMLElement) dock.classList.toggle('is-visible', show);
      };

      const updatePastHeader = () => {
        if (!(header instanceof HTMLElement)) {
          pastHeader = true;
        } else {
          pastHeader = window.scrollY + window.innerHeight * 0.3 > header.getBoundingClientRect().bottom + window.scrollY;
        }
        updateVisibility();
      };

      let scrollFrame = 0;
      window.addEventListener('scroll', () => {
        if (scrollFrame) return;
        scrollFrame = window.requestAnimationFrame(() => {
          scrollFrame = 0;
          updatePastHeader();
        });
      }, { passive: true });
      window.addEventListener('resize', updatePastHeader);

      if (footer instanceof Element && typeof IntersectionObserver === 'function') {
        const footerObserver = new IntersectionObserver((entries) => {
          footerVisible = entries.some((entry) => entry.isIntersecting);
          updateVisibility();
        }, { threshold: 0.15 });
        footerObserver.observe(footer);
      }
      updatePastHeader();
    })();
  </script>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-applause-root]');
      if (!root) return;
      const slug = root.getAttribute('data-slug') || 'post';
      const buttons = Array.from(document.querySelectorAll('[data-applause-button]'));
      if (buttons.length === 0) return;
      const counts = Array.from(document.querySelectorAll('[data-applause-count]'));
      const statusEl = document.querySelector('[data-applause-status]');
      const trap = document.querySelector('[data-applause-trap]');
      const rail = document.querySelector('[data-applause-rail]');
      const dock = document.querySelector('[data-applause-dock]');
      const footer = document.querySelector('[data-applause-footer]');
      const header = root.querySelector('.blog-post-header');

      const storageKey = `blog-applause:${slug}`;
      const cooldownMs = 600;
      const holdDelayMs = 450;
      const holdRepeatMs = 320;
      let count = 0;
      let lastPress = 0;
      let reducedMotion = false;
      try {
        reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch {}

      const readCount = () => {
        try {
          const raw = localStorage.getItem(storageKey);
          const parsed = raw === null ? 0 : Number.parseInt(raw, 10);
          return Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
        } catch {
          return count;
        }
      };

      const render = () => {
        counts.forEach((el) => {
          el.textContent = String(count);
        });
        buttons.forEach((button) => {
          if (button instanceof HTMLButtonElement) {
            button.setAttribute('aria-label', `Applaud this post, ${count} applause so far`);
          }
        });
      };

      const save = () => {
        try {
          localStorage.setItem(storageKey, String(count));
        } catch {}
      };

      const pop = (button) => {
        if (reducedMotion) return;
        const icon = button.querySelector('[data-applause-icon]');
        if (!icon || typeof icon.animate !== 'function') return;
        try {
          if (typeof icon.getAnimations === 'function') {
            icon.getAnimations().forEach((animation) => animation.cancel());
          }
          icon.animate(
            [{ transform: 'scale(1)' }, { transform: 'scale(1.25)' }, { transform: 'scale(1)' }],
            { duration: 180, easing: 'cubic-bezier(.34,1.56,.64,1)' }
          );
        } catch {}
      };

      const tryApplaud = (event, button, quiet) => {
        if (event && event.isTrusted === false) return false;
        if (trap instanceof HTMLInputElement && trap.value !== '') return false;
        const now = Date.now();
        if (now - lastPress < cooldownMs) {
          if (!quiet && statusEl) statusEl.textContent = 'A short pause keeps applause fair. Try again in a moment.';
          return false;
        }
        lastPress = now;
        count += 1;
        save();
        render();
        pop(button);
        if (statusEl) statusEl.textContent = count === 1 ? 'Thanks for the applause.' : 'Thanks, counted again.';
        return true;
      };

      buttons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', (event) => {
          tryApplaud(event, button, false);
        });
        let holdTimer = 0;
        let repeatTimer = 0;
        const clearHold = () => {
          window.clearTimeout(holdTimer);
          window.clearInterval(repeatTimer);
        };
        button.addEventListener('pointerdown', (event) => {
          if (event.isTrusted === false) return;
          window.clearTimeout(holdTimer);
          window.clearInterval(repeatTimer);
          holdTimer = window.setTimeout(() => {
            repeatTimer = window.setInterval(() => {
              tryApplaud(null, button, true);
            }, holdRepeatMs);
          }, holdDelayMs);
        });
        ['pointerup', 'pointerleave', 'pointercancel'].forEach((name) => {
          button.addEventListener(name, clearHold);
        });
      });

      window.addEventListener('storage', (event) => {
        if (event.key !== storageKey) return;
        const parsed = Number.parseInt(event.newValue ?? '0', 10);
        if (Number.isFinite(parsed) && parsed >= 0) {
          count = parsed;
          render();
        }
      });

      count = readCount();
      render();

      let pastHeader = false;
      let footerVisible = false;
      const updateVisibility = () => {
        const show = pastHeader && !footerVisible;
        if (rail instanceof HTMLElement) rail.classList.toggle('is-visible', show);
        if (dock instanceof HTMLElement) dock.classList.toggle('is-visible', show);
      };

      const updatePastHeader = () => {
        if (!(header instanceof HTMLElement)) {
          pastHeader = true;
        } else {
          pastHeader = window.scrollY + window.innerHeight * 0.3 > header.getBoundingClientRect().bottom + window.scrollY;
        }
        updateVisibility();
      };

      let scrollFrame = 0;
      window.addEventListener('scroll', () => {
        if (scrollFrame) return;
        scrollFrame = window.requestAnimationFrame(() => {
          scrollFrame = 0;
          updatePastHeader();
        });
      }, { passive: true });
      window.addEventListener('resize', updatePastHeader);

      if (footer instanceof Element && typeof IntersectionObserver === 'function') {
        const footerObserver = new IntersectionObserver((entries) => {
          footerVisible = entries.some((entry) => entry.isIntersecting);
          updateVisibility();
        }, { threshold: 0.15 });
        footerObserver.observe(footer);
      }
      updatePastHeader();
    })();
  </script>

  <script is:inline>
    const article = document.querySelector('.blog-post');
    const progress = document.querySelector('.reading-progress[data-reading-progress]');
    const progressBar = document.querySelector('[data-reading-progress-bar]');
    const railPercent = document.querySelector('[data-rail-progress-percent]');
    const railVbarFill = document.querySelector('[data-rail-progress-vbar-fill]');
    const railRingFill = document.querySelector('[data-rail-progress-ring-fill]');
    const RAIL_RING_CIRCUMFERENCE = 2 * Math.PI * 27;
    const toc = document.querySelector('[data-blog-toc]');
    const tocLinks = toc ? Array.from(toc.querySelectorAll('[data-toc-link]')) : [];
    const contentHeadings = tocLinks
      .map((link) => document.getElementById(link.getAttribute('href')?.slice(1) ?? ''))
      .filter(Boolean);

    const isReadingProgressEnabled = () => {
      const mode = document.documentElement.getAttribute('data-reading-progress');
      if (mode && mode !== 'off') return true;
      try {
        const stored = sessionStorage.getItem('readingProgress');
        return stored !== null && stored !== 'off' && stored !== '';
      } catch {
        return false;
      }
    };

    const updateProgress = () => {
      if (!isReadingProgressEnabled()) return;
      if (!article || !progress || !progressBar) return;
      const articleBounds = article.getBoundingClientRect();
      const articleStart = articleBounds.top + window.scrollY;
      const articleEnd = articleBounds.bottom + window.scrollY - window.innerHeight;
      const range = Math.max(1, articleEnd - articleStart);
      const percent = Math.min(100, Math.max(0, ((window.scrollY - articleStart) / range) * 100));
      const rounded = Math.round(percent);

      progressBar.style.transform = `scaleX(${percent / 100})`;
      progress.setAttribute('aria-valuenow', String(rounded));
      progress.setAttribute('aria-valuetext', `${rounded}% read`);
      if (railPercent) railPercent.textContent = `${rounded}%`;
      if (railVbarFill) railVbarFill.style.transform = `scaleY(${percent / 100})`;
      if (railRingFill) {
        railRingFill.style.strokeDasharray = String(RAIL_RING_CIRCUMFERENCE);
        railRingFill.style.strokeDashoffset = String(RAIL_RING_CIRCUMFERENCE * (1 - percent / 100));
      }
    };

    const updateActive = () => {
      if (tocLinks.length === 0 || contentHeadings.length === 0) return;
      const readingLine = window.scrollY + 160;
      let activeHeading = contentHeadings[0];

      contentHeadings.forEach((heading) => {
        if (heading.getBoundingClientRect().top + window.scrollY <= readingLine) {
          activeHeading = heading;
        }
      });

      tocLinks.forEach((link) => {
        const isActive = link.getAttribute('href') === `#${activeHeading.id}`;
        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    let frame = 0;
    const scheduleUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        updateProgress();
        updateActive();
      });
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', scheduleUpdate);
    updateProgress();
    updateActive();
  </script>
</Base>
