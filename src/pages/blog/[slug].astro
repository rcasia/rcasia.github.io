---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, getReadTime } from '../../dates';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  // Only build local posts; redirect-only posts link out from the index.
  return posts
    .filter((post) => !post.data.redirect)
    .map((post) => ({
      params: { slug: post.id.replace(/\.md$/, '') },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const readTime = getReadTime(post.body);
const publishedDate = post.data.date.toISOString().slice(0, 10);
const slug = post.id.replace(/\.md$/, '');
---

<Base title={post.data.title} description={post.data.description} current="blog">
  <div
    class="reading-progress"
    data-reading-progress
    role="progressbar"
    aria-label="Reading progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
    aria-valuetext="0% read"
  >
    <span class="reading-progress-bar" data-reading-progress-bar></span>
  </div>

  <article class="blog-post">
    <header class="blog-post-header">
      <p class="blog-post-back"><a href="/blog/">← blog</a></p>
      <p class="blog-post-eyebrow">Reading note</p>
      <h1>{post.data.title}</h1>
      <p class="blog-post-description">{post.data.description}</p>
      <div class="blog-post-meta" aria-label="Post metadata">
        <time datetime={publishedDate}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{readTime} min read</span>
      </div>
      {(post.data.tags.length > 0 || post.data.categories.length > 0) && (
        <ul class="blog-post-tags" aria-label="Post topics">
          {post.data.tags.map((tag) => <li><span class="tag">#{tag}</span></li>)}
          {post.data.categories.map((category) => <li><span class="tag">◎ {category}</span></li>)}
        </ul>
      )}
    </header>

    <div class="blog-post-grid">
      {tocHeadings.length > 0 && (
        <nav class="blog-toc" data-blog-toc aria-labelledby="blog-toc-title">
          <h2 id="blog-toc-title">On this page</h2>
          <ol>
            {tocHeadings.map((heading, index) => (
              <li class:list={{ 'blog-toc-subitem': heading.depth === 3 }}>
                <a
                  href={`#${heading.slug}`}
                  data-toc-link={heading.slug}
                  aria-current={index === 0 ? 'location' : undefined}
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <div class="prose blog-post-content">
        <Content />
      </div>
    </div>
  </article>

  <section class="blog-applause" data-blog-applause data-slug={slug} aria-labelledby="blog-applause-title">
    <h2 id="blog-applause-title">Enjoyed this note?</h2>
    <p class="muted">Applaud to save a local cheer. You can applaud more than once.</p>
    <div class="blog-applause-row">
      <button type="button" class="btn btn-primary" data-applause-button>Applaud</button>
      <p class="blog-applause-count" aria-live="polite"><span data-applause-count>0</span> <span data-applause-unit>applause</span></p>
    </div>
    <p class="blog-applause-status muted" data-applause-status role="status"></p>
    <input type="text" name="company" value="" autocomplete="off" tabindex="-1" aria-hidden="true" data-applause-trap class="blog-applause-trap" />
  </section>

  <script is:inline>
    (() => {
      const container = document.querySelector('[data-blog-applause]');
      if (!container) return;
      const slug = container.getAttribute('data-slug') || 'post';
      const button = container.querySelector('[data-applause-button]');
      const countEl = container.querySelector('[data-applause-count]');
      const statusEl = container.querySelector('[data-applause-status]');
      const trap = container.querySelector('[data-applause-trap]');
      if (!(button instanceof HTMLButtonElement) || !countEl || !statusEl) return;

      const storageKey = `blog-applause:${slug}`;
      const cooldownMs = 1200;
      let count = 0;
      let lastPress = 0;
      let cooldownTimer = 0;

      const readCount = () => {
        try {
          const raw = localStorage.getItem(storageKey);
          const parsed = raw === null ? 0 : Number.parseInt(raw, 10);
          return Number.isFinite(parsed) && parsed >= 0 ? parsed : 0;
        } catch {
          return count;
        }
      };

      const render = () => {
        countEl.textContent = String(count);
      };

      const save = () => {
        try {
          localStorage.setItem(storageKey, String(count));
        } catch {}
      };

      count = readCount();
      render();

      button.addEventListener('click', (event) => {
        if (event.isTrusted === false) return;
        if (trap instanceof HTMLInputElement && trap.value !== '') return;
        const now = Date.now();
        if (now - lastPress < cooldownMs) {
          statusEl.textContent = 'A short pause keeps applause fair. Try again in a moment.';
          return;
        }
        lastPress = now;
        count += 1;
        save();
        render();
        statusEl.textContent = count === 1 ? 'Thanks for the applause.' : 'Thanks, counted again.';
        button.disabled = true;
        window.clearTimeout(cooldownTimer);
        cooldownTimer = window.setTimeout(() => {
          button.disabled = false;
        }, cooldownMs);
      });
    })();
  </script>

  <script is:inline>
    const article = document.querySelector('.blog-post');
    const progress = document.querySelector('[data-reading-progress]');
    const progressBar = document.querySelector('[data-reading-progress-bar]');
    const toc = document.querySelector('[data-blog-toc]');
    const tocLinks = toc ? Array.from(toc.querySelectorAll('[data-toc-link]')) : [];
    const contentHeadings = tocLinks
      .map((link) => document.getElementById(link.getAttribute('href')?.slice(1) ?? ''))
      .filter(Boolean);

    const updateProgress = () => {
      if (!article || !progress || !progressBar) return;
      const articleBounds = article.getBoundingClientRect();
      const articleStart = articleBounds.top + window.scrollY;
      const articleEnd = articleBounds.bottom + window.scrollY - window.innerHeight;
      const range = Math.max(1, articleEnd - articleStart);
      const percent = Math.min(100, Math.max(0, ((window.scrollY - articleStart) / range) * 100));
      const rounded = Math.round(percent);

      progressBar.style.transform = `scaleX(${percent / 100})`;
      progress.setAttribute('aria-valuenow', String(rounded));
      progress.setAttribute('aria-valuetext', `${rounded}% read`);
    };

    const updateActive = () => {
      if (tocLinks.length === 0 || contentHeadings.length === 0) return;
      const readingLine = window.scrollY + 160;
      let activeHeading = contentHeadings[0];

      contentHeadings.forEach((heading) => {
        if (heading.getBoundingClientRect().top + window.scrollY <= readingLine) {
          activeHeading = heading;
        }
      });

      tocLinks.forEach((link) => {
        const isActive = link.getAttribute('href') === `#${activeHeading.id}`;
        if (isActive) {
          link.setAttribute('aria-current', 'location');
        } else {
          link.removeAttribute('aria-current');
        }
      });
    };

    let frame = 0;
    const scheduleUpdate = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(() => {
        frame = 0;
        updateProgress();
        updateActive();
      });
    };

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.addEventListener('hashchange', scheduleUpdate);
    updateProgress();
    updateActive();
  </script>
</Base>
