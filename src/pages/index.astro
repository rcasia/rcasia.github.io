---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE } from '../site';
import { formatDate } from '../dates';
import profPic from '../assets/prof_pic.jpg';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = posts.slice(0, 3);
---

<Base current="about" title="about" description={SITE.description}>
  <article class="hero">
    <h1>Ricardo Casía Moka</h1>
    <p class="subtitle">Senior Software Engineer</p>

    <div class="about-grid">
      <div>
        <p>
          I'm Ricardo Casía Moka, a Senior Software Engineer at Thoughtworks. I architect scalable systems,
          lead technical initiatives, and mentor development teams for enterprise clients. I'm passionate
          about clean code, test-driven development, and building software that stands the test of time.
        </p>
        <p>
          I maintain several open source projects focused on developer tooling. These include
          <a href="/projects/neotest-java/">neotest-java</a> and
          <a href="/projects/neotest-bash/">neotest-bash</a>, test adapters for Java and Bash workflows
          in Neovim, and <a href="/projects/ascii-ui-nvim/">ascii-ui.nvim</a>, a library of ASCII-based
          UI components for Neovim plugins.
        </p>
        <p>
          Through this blog, I share technical insights, engineering practices, and tool configurations
          to contribute to the developer community.
        </p>
        <p><strong>Focus areas</strong></p>
        <ul>
          <li>Scalable systems</li>
          <li>Technical leadership</li>
          <li>Mentoring development teams</li>
          <li>Clean code and test-driven development</li>
          <li>Neovim tooling</li>
          <li>Harness engineering</li>
          <li>AI delivery</li>
        </ul>
        <div class="cta-row">
          <button class="btn btn-primary" id="contact-toggle" aria-expanded="false" aria-controls="contact-panel">Get in touch</button>
          <a class="btn" href="/projects/">View projects</a>
          <a class="btn" href="/blog/">Read blog</a>
          <a class="btn" href={SITE.github} target="_blank" rel="noopener">GitHub</a>
        </div>
        <div id="contact-panel" class="contact-panel" hidden>
          <p class="contact-title"><strong>Contact</strong></p>
          <ul class="contact-list">
            <li>
              <span>Email: <code id="contact-email">{SITE.email}</code></span>
              <button class="btn btn-small" id="copy-email" type="button">Copy</button>
            </li>
            <li>
              GitHub: <a href={SITE.github} target="_blank" rel="noopener">{SITE.github.replace('https://', '')}</a>
            </li>
            <li>
              LinkedIn: <a href={SITE.linkedin} target="_blank" rel="noopener">{SITE.linkedin.replace('https://', '')}</a>
            </li>
            <li>
              X: <a href={SITE.x} target="_blank" rel="noopener">{SITE.x.replace('https://', '')}</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="profile-wrap">
        <Image
          src={profPic}
          alt="Portrait of Ricardo Casía Moka"
          widths={[320, 480, 640]}
          sizes="(max-width: 640px) 320px, 220px"
          format="webp"
          loading="eager"
        />
      </div>
    </div>

    <h2><a href="/blog/" style="color: inherit;">latest posts</a></h2>
    {
      latest.length === 0 ? (
        <p style="color: var(--muted)">No posts yet.</p>
      ) : (
        <ul class="post-list">
          {latest.map((post) => {
            const href = post.data.redirect ?? `/blog/${post.slug}/`;
            const external = Boolean(post.data.redirect);
            return (
              <li class="post-item">
                <div style="display:flex;gap:1rem;align-items:baseline;flex-wrap:wrap;">
                  <time style="color: var(--muted); font-size: 0.9rem; min-width: 90px;">
                    {formatDate(post.data.date)}
                  </time>
                  <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                    {post.data.title} {external && <span aria-hidden="true">↗</span>}
                  </a>
                </div>
                {post.data.external_source && (
                  <div class="post-meta">
                    <span>Cross-posted on {post.data.external_source}</span>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </article>
  <script is:inline>
    const toggle = document.getElementById('contact-toggle');
    const panel = document.getElementById('contact-panel');
    const copyBtn = document.getElementById('copy-email');
    const showPanel = () => {
      panel?.removeAttribute('hidden');
      toggle?.setAttribute('aria-expanded', 'true');
    };
    toggle?.addEventListener('click', () => {
      const isHidden = panel?.hasAttribute('hidden');
      if (isHidden) {
        showPanel();
      } else {
        panel?.setAttribute('hidden', '');
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });
    if (window.location.hash === '#contact-panel') {
      showPanel();
    }
    copyBtn?.addEventListener('click', async () => {
      const email = document.getElementById('contact-email')?.textContent?.trim();
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        copyBtn.textContent = 'Copied!';
      } catch {
        const range = document.createRange();
        const node = document.getElementById('contact-email');
        if (node) {
          range.selectNodeContents(node);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        copyBtn.textContent = 'Select & copy';
      }
      setTimeout(() => {
        if (copyBtn) copyBtn.textContent = 'Copy';
      }, 2000);
    });
  </script>
</Base>
