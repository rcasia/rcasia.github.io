---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE } from '../site';
import { formatDate } from '../dates';
import profPic from '../assets/prof_pic.jpg';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = posts.slice(0, 3);

const work = (await getCollection('projects')).sort((a, b) => a.data.importance - b.data.importance);

// Code excerpts below are trimmed verbatim quotes from each repo's README
// (lazy.nvim setup blocks + ascii-ui counter example + its rendered output).
// No screenshots are hotlinked: the READMEs only expose expiring
// private-user-images URLs, so code-as-visual is the honest preview.
const SNIPPETS: Record<string, { file: string; code: string; output?: string }> = {
  'neotest-java': {
    file: 'lazy.lua',
    code: `{
  "rcasia/neotest-java",
  ft = "java",
  dependencies = {
    "mfussenegger/nvim-jdtls",
  },
}`,
  },
  'neotest-bash': {
    file: 'lazy.lua',
    code: `require("neotest").setup({
  adapters = {
    require("neotest-bash")
  }
})`,
  },
  'ascii-ui-nvim': {
    file: 'counter.lua',
    code: `local Paragraph = ui.components.Paragraph
local Button = ui.components.Button

return ui.createComponent("Counter", function()
    local count, setCount = useState(0)`,
    output: `╭──────────────╮
│ Count: 0     │
│ [ +1 ]       │
╰──────────────╯`,
  },
};
---

<Base current="about" title="about" description={SITE.description}>
  <article class="hero">
    <h1>Ricardo Casía Moka</h1>
    <p class="subtitle">Senior Software Engineer</p>

    <div class="about-grid">
      <div>
        <p>
          I'm Ricardo Casía Moka, a Senior Software Engineer at Thoughtworks. I architect scalable systems,
          lead technical initiatives, and mentor development teams for enterprise clients. I'm passionate
          about clean code, test-driven development, and building software that stands the test of time.
        </p>
        <p>
          I maintain several open source projects focused on developer tooling. These include
          <a href="https://github.com/rcasia/neotest-java" target="_blank" rel="noopener">neotest-java</a> and
          <a href="https://github.com/rcasia/neotest-bash" target="_blank" rel="noopener">neotest-bash</a>, test adapters for Java and Bash workflows
          in Neovim, and <a href="https://github.com/ascii-ui/ascii-ui.nvim" target="_blank" rel="noopener">ascii-ui.nvim</a>, a library of ASCII-based
          UI components for Neovim plugins.
        </p>
        <p>
          Through this blog, I share technical insights, engineering practices, and tool configurations
          to contribute to the developer community.
        </p>
        <p><strong>Focus areas</strong></p>
        <ul>
          <li>Scalable systems</li>
          <li>Technical leadership</li>
          <li>Mentoring development teams</li>
          <li>Clean code and test-driven development</li>
          <li>Neovim tooling</li>
          <li>Harness engineering</li>
          <li>AI delivery</li>
        </ul>
        <div class="cta-row">
          <button class="btn btn-primary" id="contact-toggle" aria-expanded="false" aria-controls="contact-panel">Get in touch</button>
          <a class="btn" href="/projects/">View projects</a>
          <a class="btn" href="/blog/">Read blog</a>
          <a class="btn" href={SITE.github} target="_blank" rel="noopener">GitHub</a>
        </div>
        <div id="contact-panel" class="contact-panel" hidden>
          <p class="contact-title"><strong>Contact</strong></p>
          <ul class="contact-list">
            <li>
              <span>Email: <code id="contact-email">{SITE.email}</code></span>
              <button class="btn btn-small" id="copy-email" type="button">Copy</button>
            </li>
            <li>
              GitHub: <a href={SITE.github} target="_blank" rel="noopener">{SITE.github.replace('https://', '')}</a>
            </li>
            <li>
              LinkedIn: <a href={SITE.linkedin} target="_blank" rel="noopener">{SITE.linkedin.replace('https://', '')}</a>
            </li>
            <li>
              X: <a href={SITE.x} target="_blank" rel="noopener">{SITE.x.replace('https://', '')}</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="profile-wrap">
        <Image
          src={profPic}
          alt="Portrait of Ricardo Casía Moka"
          widths={[320, 480, 640]}
          sizes="(max-width: 640px) 320px, 220px"
          format="webp"
          loading="eager"
        />
      </div>
    </div>

    <section class="work" aria-labelledby="work-heading">
      <div class="work-head">
        <h2 id="work-heading"><a href="/projects/" style="color: inherit;">selected work</a></h2>
        <div class="work-controls">
          <p class="work-pos" aria-live="polite" aria-atomic="true">
            <span id="work-current">01</span><span aria-hidden="true"> / </span><span id="work-total">03</span>
            <span class="sr-only">projects shown</span>
          </p>
          <div class="work-nav" role="group" aria-label="Browse projects">
            <button class="work-btn" id="work-prev" type="button" aria-label="Previous project">←</button>
            <button class="work-btn" id="work-next" type="button" aria-label="Next project">→</button>
          </div>
        </div>
      </div>
      <div
        class="work-strip"
        id="work-strip"
        role="region"
        aria-roledescription="carousel"
        aria-label="Selected open source projects"
        tabindex="0"
      >
        <ol class="work-track">
          {work.map((p, i) => {
            const key = p.id.replace(/\.md$/, '');
            const snap = SNIPPETS[key] ?? SNIPPETS['neotest-java'];
            const num = String(i + 1).padStart(2, '0');
            return (
              <li class="work-slide">
                <article class="card work-card" aria-labelledby={`work-title-${key}`}>
                  <span class="work-idx" aria-hidden="true">{num}</span>
                  <h3 class="work-name" id={`work-title-${key}`}>
                    <a href={p.data.github} target="_blank" rel="noopener">
                      {p.data.title} <span aria-hidden="true">↗</span>
                    </a>
                  </h3>
                  <p class="work-desc">{p.data.description}</p>
                  <div class="term">
                    <div class="term-bar" aria-hidden="true">
                      <span class="term-dots"><i></i><i></i><i></i></span>
                      <span class="term-file">{snap.file}</span>
                      <span class="term-lang">lua</span>
                    </div>
                    <pre class="term-code"><code>{snap.code}</code></pre>
                    {snap.output && (
                      <pre class="term-out"><code>{snap.output}</code></pre>
                    )}
                  </div>
                  <ul class="work-tech" aria-label={`Technologies in ${p.data.title}`}>
                    {p.data.tech.slice(0, 4).map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </article>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <h2><a href="/blog/" style="color: inherit;">latest posts</a></h2>
    {
      latest.length === 0 ? (
        <p style="color: var(--muted)">No posts yet.</p>
      ) : (
        <ul class="post-list">
          {latest.map((post) => {
            const href = post.data.redirect ?? `/blog/${post.slug}/`;
            const external = Boolean(post.data.redirect);
            return (
              <li class="post-item">
                <div style="display:flex;gap:1rem;align-items:baseline;flex-wrap:wrap;">
                  <time style="color: var(--muted); font-size: 0.9rem; min-width: 90px;">
                    {formatDate(post.data.date)}
                  </time>
                  <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                    {post.data.title} {external && <span aria-hidden="true">↗</span>}
                  </a>
                </div>
                {post.data.external_source && (
                  <div class="post-meta">
                    <span>Cross-posted on {post.data.external_source}</span>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      )
    }
  </article>
  <script is:inline>
    const toggle = document.getElementById('contact-toggle');
    const panel = document.getElementById('contact-panel');
    const copyBtn = document.getElementById('copy-email');
    const showPanel = () => {
      panel?.removeAttribute('hidden');
      toggle?.setAttribute('aria-expanded', 'true');
    };
    toggle?.addEventListener('click', () => {
      const isHidden = panel?.hasAttribute('hidden');
      if (isHidden) {
        showPanel();
      } else {
        panel?.setAttribute('hidden', '');
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });
    if (window.location.hash === '#contact-panel') {
      showPanel();
    }
    copyBtn?.addEventListener('click', async () => {
      const email = document.getElementById('contact-email')?.textContent?.trim();
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        copyBtn.textContent = 'Copied!';
      } catch {
        const range = document.createRange();
        const node = document.getElementById('contact-email');
        if (node) {
          range.selectNodeContents(node);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        copyBtn.textContent = 'Select & copy';
      }
      setTimeout(() => {
        if (copyBtn) copyBtn.textContent = 'Copy';
      }, 2000);
    });
  </script>
  <script is:inline>
    (() => {
      const strip = document.getElementById('work-strip');
      const prev = document.getElementById('work-prev');
      const next = document.getElementById('work-next');
      const current = document.getElementById('work-current');
      const total = document.getElementById('work-total');
      if (!strip || !prev || !next || !current) return;
      const slides = Array.from(strip.querySelectorAll('.work-slide'));
      if (total) total.textContent = String(slides.length).padStart(2, '0');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const gap = () => {
        const track = strip.querySelector('.work-track');
        if (!track) return 16;
        return parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 16;
      };
      const step = () => (slides[0]?.getBoundingClientRect().width ?? 320) + gap();
      const behavior = () => (reduceMotion.matches ? 'auto' : 'smooth');
      const update = () => {
        const max = strip.scrollWidth - strip.clientWidth;
        const idx = Math.min(
          slides.length - 1,
          Math.max(0, Math.round(strip.scrollLeft / step()))
        );
        current.textContent = String(idx + 1).padStart(2, '0');
        prev.disabled = strip.scrollLeft <= 4;
        next.disabled = strip.scrollLeft >= max - 4;
      };
      let ticking = false;
      strip.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        },
        { passive: true }
      );
      prev.addEventListener('click', () => strip.scrollBy({ left: -step(), behavior: behavior() }));
      next.addEventListener('click', () => strip.scrollBy({ left: step(), behavior: behavior() }));
      strip.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          strip.scrollBy({ left: step(), behavior: behavior() });
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          strip.scrollBy({ left: -step(), behavior: behavior() });
        } else if (e.key === 'Home') {
          e.preventDefault();
          strip.scrollTo({ left: 0, behavior: behavior() });
        } else if (e.key === 'End') {
          e.preventDefault();
          strip.scrollTo({ left: strip.scrollWidth, behavior: behavior() });
        }
      });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
</Base>
