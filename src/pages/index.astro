---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE } from '../site';
import { formatDate } from '../dates';
import profPic from '../assets/prof_pic.jpg';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = posts.slice(0, 3);

const work = (await getCollection('projects')).sort((a, b) => {
  const aIsAsciiUi = a.id.replace(/\.md$/, '') === 'ascii-ui-nvim';
  const bIsAsciiUi = b.id.replace(/\.md$/, '') === 'ascii-ui-nvim';
  if (aIsAsciiUi !== bIsAsciiUi) return aIsAsciiUi ? -1 : 1;
  return a.data.importance - b.data.importance;
});

const PREVIEWS: Record<string, { src: string; alt: string; className?: string }> = {
  'neotest-java': {
    src: '/project-previews/neotest-java.png',
    alt: 'Neovim showing the neotest-java test tree beside Java test code and JUnit output.',
  },
  'neotest-bash': {
    src: '/project-previews/neotest-bash.png',
    alt: 'Neovim showing a Bash test file beside bashunit results with passing tests.',
  },
  'ascii-ui-nvim': {
    src: '/project-previews/ascii-ui-map.gif',
    alt: 'A real ASCII metro map rendered by an ascii-ui.nvim example.',
    className: 'work-visual-ascii',
  },
};
---

<Base current="about" description={SITE.description}>
  <article class="hero">
    <h1>Ricardo Casía Moka</h1>
    <p class="subtitle">Senior Software Engineer</p>

    <div class="about-grid">
      <div class="hero-copy">
        <div data-hero-stable>
          <p>
            I build developer tools that shorten the loop between writing code and trusting it.
          </p>
          <p>
            I maintain Neovim tooling for testing, debugging, and UI infrastructure, and I'm currently
            exploring deterministic guardrails for agentic coding.
          </p>
        </div>
        <div data-hero-experiment hidden>
          <p>
            I build developer tools that shorten the loop between writing code and trusting it.
          </p>
          <p>
            I am a software engineer focused on backend, working on cloud, retail systems modernizations
            and integrations, and API design across industries, Agile with clean, modular code.
          </p>
          <p>
            I contribute to open source tooling, maintain Neovim testing and UI infrastructure, and run
            complex systems with modern delivery workflows. My background in Philosophy and Laws supports
            a thoughtful, analytical focus on maintainable, high-quality code.
          </p>
        </div>
        <div class="cta-row" data-cta-stable>
          <a class="btn btn-primary" href="/projects/">View selected work</a>
          <a class="btn" href={SITE.github} target="_blank" rel="noopener">GitHub</a>
          <a class="btn" href="/contact/">Get in touch</a>
        </div>
        <nav class="cta-experiment" data-cta-experiment hidden aria-label="Primary actions">
          <div class="cta-main">
            <a class="btn btn-primary cta-primary" href="/projects/">
              View selected work <span aria-hidden="true" class="cta-arrow">→</span>
            </a>
            <a class="btn cta-secondary" href="/contact/">Get in touch</a>
          </div>
          <a class="cta-tertiary" href={SITE.github} target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.9-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.35 1.08 2.92.83.1-.65.35-1.09.63-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.58 9.58 0 0 1 5 0c1.91-1.3 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85V21c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"/></svg>
            <span>GitHub</span>
            <span aria-hidden="true">↗</span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </nav>
      </div>
      <div class="profile-wrap">
        <Image
          src={profPic}
          alt="Portrait of Ricardo Casía Moka"
          widths={[320, 480, 640]}
          sizes="(max-width: 640px) 320px, 220px"
          format="webp"
          loading="eager"
        />
      </div>
    </div>

    <section class="section-block" aria-labelledby="experiments-heading">
      <h2 id="experiments-heading" class="section-heading">Now experimenting</h2>
      <p>
        Deterministic guardrails around non-deterministic agents: pre-commits and checks stay fixed
        while agents write the code; skills only where a flow needs one. Testing whether TCR
        (test &amp;&amp; commit || revert) makes agents more reliable. RFC plus early POC, measuring
        token cost and failure modes.
      </p>
      <p>
        <a href="https://github.com/rcasia/agentic-tcr-poc" target="_blank" rel="noopener">agentic-tcr-poc</a>
         <span class="muted">(early)</span>
      </p>
    </section>

    <section class="work section-block" aria-labelledby="work-heading">
      <div class="work-head">
        <h2 id="work-heading" class="section-heading"><a href="/projects/">selected work</a></h2>
      </div>
      <p class="section-dek">Each one shortens that loop in a different place.</p>
      <ol class="work-grid">
        {work.map((p, i) => {
          const key = p.id.replace(/\.md$/, '');
          const preview = PREVIEWS[key];
          const num = String(i + 1).padStart(2, '0');
          return (
            <li class="work-item">
              <article class="card work-card" aria-labelledby={`work-title-${key}`}>
                <span class="work-idx" aria-hidden="true">{num}</span>
                <h3 class="work-name" id={`work-title-${key}`}>
                  <a href={p.data.github} target="_blank" rel="noopener">
                    {p.data.title} <span aria-hidden="true">↗</span>
                  </a>
                </h3>
                <p class="work-desc">{p.data.description}</p>
                {preview && (
                  <div class:list={['work-visual', preview.className]}>
                    <img src={preview.src} alt={preview.alt} loading="lazy" decoding="async" />
                  </div>
                )}
                <ul class="work-tech" aria-label={`Technologies in ${p.data.title}`}>
                  {p.data.tech.slice(0, 4).map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </article>
            </li>
          );
        })}
      </ol>
    </section>

    <section class="section-block latest-notes" aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="section-heading"><a href="/blog/">latest note</a></h2>
      {
        latest.length === 0 ? (
          <p class="muted">No posts yet.</p>
        ) : (
          <ul class="post-list">
            {latest.map((post) => {
              const href = post.data.redirect ?? `/blog/${post.id.replace(/\.md$/, '')}/`;
              const external = Boolean(post.data.redirect);
              return (
                <li class="post-item">
                  <div class="post-home-row">
                    <time class="post-date">{formatDate(post.data.date)}</time>
                    <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                      {post.data.title} {external && <span aria-hidden="true">↗</span>}
                    </a>
                  </div>
                  {post.data.external_source && (
                    <div class="post-meta">
                      <span>Cross-posted on {post.data.external_source}</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
    </section>
  </article>
</Base>
