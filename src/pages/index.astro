---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { SITE } from '../site';
import { formatDate } from '../dates';
import profPic from '../assets/prof_pic.jpg';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = posts.slice(0, 3);

const work = (await getCollection('projects')).sort((a, b) => {
  const aIsAsciiUi = a.id.replace(/\.md$/, '') === 'ascii-ui-nvim';
  const bIsAsciiUi = b.id.replace(/\.md$/, '') === 'ascii-ui-nvim';
  if (aIsAsciiUi !== bIsAsciiUi) return aIsAsciiUi ? -1 : 1;
  return a.data.importance - b.data.importance;
});

const PREVIEWS: Record<string, { src: string; alt: string; className?: string }> = {
  'neotest-java': {
    src: '/project-previews/neotest-java.png',
    alt: 'Neovim showing the neotest-java test tree beside Java test code and JUnit output.',
  },
  'neotest-bash': {
    src: '/project-previews/neotest-bash.png',
    alt: 'Neovim showing a Bash test file beside bashunit results with passing tests.',
  },
  'ascii-ui-nvim': {
    src: '/project-previews/ascii-ui-map.gif',
    alt: 'A real ASCII metro map rendered by an ascii-ui.nvim example.',
    className: 'work-visual-ascii',
  },
};
---

<Base current="about" title="about" description={SITE.description}>
  <article class="hero">
    <h1>Ricardo Casía Moka</h1>
    <p class="subtitle">Senior Software Engineer at Thoughtworks</p>

    <div class="about-grid">
      <div class="hero-copy">
        <p>
          I build developer tools that shorten the loop between writing code and trusting it.
        </p>
        <p>
          I maintain Neovim tooling for testing, debugging, and UI infrastructure, and I'm currently
          exploring deterministic guardrails for agentic coding.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="/projects/">View selected work</a>
          <a class="btn" href={SITE.github} target="_blank" rel="noopener">GitHub</a>
          <button class="btn" id="contact-toggle" aria-expanded="false" aria-controls="contact-panel">Get in touch</button>
        </div>
        <div id="contact-panel" class="contact-panel" hidden>
          <p class="contact-title"><strong>Contact</strong></p>
          <ul class="contact-list">
            <li>
              <span>Email: <code id="contact-email">{SITE.email}</code></span>
              <button class="btn btn-small" id="copy-email" type="button">Copy</button>
            </li>
            <li>
              GitHub: <a href={SITE.github} target="_blank" rel="noopener">{SITE.github.replace('https://', '')}</a>
            </li>
            <li>
              LinkedIn: <a href={SITE.linkedin} target="_blank" rel="noopener">{SITE.linkedin.replace('https://', '')}</a>
            </li>
            <li>
              X: <a href={SITE.x} target="_blank" rel="noopener">{SITE.x.replace('https://', '')}</a>
            </li>
          </ul>
        </div>
      </div>
      <div class="profile-wrap">
        <Image
          src={profPic}
          alt="Portrait of Ricardo Casía Moka"
          widths={[320, 480, 640]}
          sizes="(max-width: 640px) 320px, 220px"
          format="webp"
          loading="eager"
        />
      </div>
    </div>

    <section class="work section-block" aria-labelledby="work-heading">
      <div class="work-head">
        <h2 id="work-heading" class="section-heading"><a href="/projects/">selected work</a></h2>
        <div class="work-controls">
          <p class="work-pos" aria-live="polite" aria-atomic="true">
            <span id="work-current">01</span><span aria-hidden="true"> / </span><span id="work-total">03</span>
            <span class="sr-only">projects shown</span>
          </p>
          <div class="work-nav" role="group" aria-label="Browse projects">
            <button class="work-btn" id="work-prev" type="button" aria-label="Previous project">←</button>
            <button class="work-btn" id="work-next" type="button" aria-label="Next project">→</button>
          </div>
        </div>
      </div>
      <p class="section-dek">Each one shortens that loop in a different place.</p>
      <div
        class="work-strip"
        id="work-strip"
        role="region"
        aria-roledescription="carousel"
        aria-label="Selected open source projects"
        tabindex="0"
      >
        <ol class="work-track">
          {work.map((p, i) => {
            const key = p.id.replace(/\.md$/, '');
            const preview = PREVIEWS[key];
            const num = String(i + 1).padStart(2, '0');
            return (
              <li class="work-slide">
                <article class="card work-card" aria-labelledby={`work-title-${key}`}>
                  <span class="work-idx" aria-hidden="true">{num}</span>
                  <h3 class="work-name" id={`work-title-${key}`}>
                    <a href={p.data.github} target="_blank" rel="noopener">
                      {p.data.title} <span aria-hidden="true">↗</span>
                    </a>
                  </h3>
                  <p class="work-desc">{p.data.description}</p>
                  {preview && (
                    <div class:list={['work-visual', preview.className]}>
                      <img src={preview.src} alt={preview.alt} loading="lazy" decoding="async" />
                    </div>
                  )}
                  <ul class="work-tech" aria-label={`Technologies in ${p.data.title}`}>
                    {p.data.tech.slice(0, 4).map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </article>
              </li>
            );
          })}
        </ol>
      </div>
    </section>

    <section class="section-block" aria-labelledby="experiments-heading">
      <h2 id="experiments-heading" class="section-heading">Now experimenting</h2>
      <p>
        Deterministic guardrails around non-deterministic agents: pre-commits and checks stay fixed
        while agents write the code; skills only where a flow needs one. Testing whether TCR
        (test &amp;&amp; commit || revert) makes agents more reliable. RFC plus early POC, measuring
        token cost and failure modes.
      </p>
      <p>
        <a href="https://github.com/rcasia/agentic-tcr-poc" target="_blank" rel="noopener">agentic-tcr-poc</a>
         <span class="muted">(early)</span>
      </p>
    </section>

    <section class="section-block latest-notes" aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="section-heading"><a href="/blog/">latest note</a></h2>
      {
        latest.length === 0 ? (
          <p class="muted">No posts yet.</p>
        ) : (
          <ul class="post-list">
            {latest.map((post) => {
              const href = post.data.redirect ?? `/blog/${post.slug}/`;
              const external = Boolean(post.data.redirect);
              return (
                <li class="post-item">
                  <div class="post-home-row">
                    <time class="post-date">{formatDate(post.data.date)}</time>
                    <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                      {post.data.title} {external && <span aria-hidden="true">↗</span>}
                    </a>
                  </div>
                  {post.data.external_source && (
                    <div class="post-meta">
                      <span>Cross-posted on {post.data.external_source}</span>
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        )
      }
    </section>
  </article>
  <script is:inline>
    const toggle = document.getElementById('contact-toggle');
    const panel = document.getElementById('contact-panel');
    const copyBtn = document.getElementById('copy-email');
    const showPanel = () => {
      panel?.removeAttribute('hidden');
      toggle?.setAttribute('aria-expanded', 'true');
    };
    toggle?.addEventListener('click', () => {
      const isHidden = panel?.hasAttribute('hidden');
      if (isHidden) {
        showPanel();
      } else {
        panel?.setAttribute('hidden', '');
        toggle?.setAttribute('aria-expanded', 'false');
      }
    });
    if (window.location.hash === '#contact-panel') {
      showPanel();
    }
    copyBtn?.addEventListener('click', async () => {
      const email = document.getElementById('contact-email')?.textContent?.trim();
      if (!email) return;
      try {
        await navigator.clipboard.writeText(email);
        copyBtn.textContent = 'Copied!';
      } catch {
        const range = document.createRange();
        const node = document.getElementById('contact-email');
        if (node) {
          range.selectNodeContents(node);
          const sel = window.getSelection();
          sel?.removeAllRanges();
          sel?.addRange(range);
        }
        copyBtn.textContent = 'Select & copy';
      }
      setTimeout(() => {
        if (copyBtn) copyBtn.textContent = 'Copy';
      }, 2000);
    });
  </script>
  <script is:inline>
    (() => {
      const strip = document.getElementById('work-strip');
      const prev = document.getElementById('work-prev');
      const next = document.getElementById('work-next');
      const current = document.getElementById('work-current');
      const total = document.getElementById('work-total');
      if (!strip || !prev || !next || !current) return;
      const slides = Array.from(strip.querySelectorAll('.work-slide'));
      if (total) total.textContent = String(slides.length).padStart(2, '0');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const gap = () => {
        const track = strip.querySelector('.work-track');
        if (!track) return 16;
        return parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 16;
      };
      const step = () => (slides[0]?.getBoundingClientRect().width ?? 320) + gap();
      const behavior = () => (reduceMotion.matches ? 'auto' : 'smooth');
      const update = () => {
        const max = strip.scrollWidth - strip.clientWidth;
        const idx = Math.min(
          slides.length - 1,
          Math.max(0, Math.round(strip.scrollLeft / step()))
        );
        current.textContent = String(idx + 1).padStart(2, '0');
        prev.disabled = strip.scrollLeft <= 4;
        next.disabled = strip.scrollLeft >= max - 4;
      };
      let ticking = false;
      strip.addEventListener(
        'scroll',
        () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            update();
            ticking = false;
          });
        },
        { passive: true }
      );
      prev.addEventListener('click', () => strip.scrollBy({ left: -step(), behavior: behavior() }));
      next.addEventListener('click', () => strip.scrollBy({ left: step(), behavior: behavior() }));
      strip.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          strip.scrollBy({ left: step(), behavior: behavior() });
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          strip.scrollBy({ left: -step(), behavior: behavior() });
        } else if (e.key === 'Home') {
          e.preventDefault();
          strip.scrollTo({ left: 0, behavior: behavior() });
        } else if (e.key === 'End') {
          e.preventDefault();
          strip.scrollTo({ left: strip.scrollWidth, behavior: behavior() });
        }
      });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
</Base>
