---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, github, tech } = project.data;
---

<Base current="projects" title={title} description={description}>
  <article class="prose project-detail">
    <p><a href="/projects/">← projects</a></p>
    <header class="project-detail-header">
      <p class="subtitle">{project.data.category}</p>
      <h1>{title}</h1>
      <p class="project-detail-description">{description}</p>
      <ul class="project-detail-tech" aria-label={`Technologies used by ${title}`}>
        {tech.map((item) => <li>{item}</li>)}
      </ul>
      {github && (
        <p>
          <a class="btn btn-primary" href={github} target="_blank" rel="noopener">
            View on GitHub <span aria-hidden="true">↗</span>
          </a>
        </p>
      )}
    </header>
    <Content />
  </article>
</Base>
