---
import Base from '../../layouts/Base.astro';
import ProjectsCards from '../../components/projects/ProjectsCards.astro';
import ProjectsV2 from '../../components/projects/ProjectsV2.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<Base current="projects" title="projects" description="Open-source Neovim tooling by Ricardo Casía Moka.">
  <script is:inline>
    try {
      if (localStorage.getItem('projectsV2') === 'true') {
        document.documentElement.setAttribute('data-projects-v2', '');
      }
    } catch {}
  </script>
  <style>
    html[data-projects-v2] #projects-current {
      display: none;
    }
  </style>

  <h1 style="margin-top: 2.5rem;">projects</h1>
  <hr style="border: none; border-top: 1px solid var(--border); margin: 1.5rem 0;" />
  <div style="display: flex; justify-content: flex-end; margin: 1rem 0;">
    <button class="btn" id="open-feature-flags" type="button">Feature flags</button>
  </div>
  <div id="projects-current">
    <ProjectsCards projects={projects} />
  </div>
  <template id="projects-v2">
    <ProjectsV2 projects={projects} />
  </template>

  <script is:inline>
    const root = document.documentElement;
    const current = document.getElementById('projects-current');
    const experimental = document.getElementById('projects-v2');

    if (root.hasAttribute('data-projects-v2') && current && experimental instanceof HTMLTemplateElement) {
      current.replaceChildren(experimental.content.cloneNode(true));
      experimental.remove();
      root.removeAttribute('data-projects-v2');
    }
  </script>
  <script is:inline>
    document.getElementById('open-feature-flags')?.addEventListener('click', () => {
      document.dispatchEvent(new Event('feature-flag-panel:open'));
    });
  </script>
</Base>
